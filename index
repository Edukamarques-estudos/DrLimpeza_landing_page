<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Doutor Limpeza Tatuí | Lavagem e Higienização de Estofados e Colchões</title>
<meta name="description" content="Doutor Limpeza - Lavagem e higienização profissional de sofás, colchões, poltronas e bancos de carros em Tatuí e região. Mais que limpeza, é saúde!">
<style>
  :root {
    --bg-dark: #0b0e10;
    --card-dark: #14191d;
    --card-border: #252e34;
    --lime: #8ce000;
    --lime-hover: #9ef50a;
    --lime-soft: rgba(140, 224, 0, 0.14);
    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --wa-green: #25D366;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    line-height: 1.55;
    overflow-x: hidden;
  }

  /* Navbar */
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(11, 14, 16, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--card-border);
    padding: 12px 20px;
  }
  .nav-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .brand-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--lime);
    letter-spacing: 0.5px;
    line-height: 1.1;
  }
  .brand-sub {
    font-size: 0.7rem;
    color: #cbd5e1;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .nav-links {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .nav-links a.menu-link {
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
    transition: 0.15s;
  }
  .nav-links a.menu-link:hover { color: var(--lime); }

  /* Social Icon Pills */
  .social-bar {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .social-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #fff;
    transition: transform 0.18s, box-shadow 0.18s;
    border: 1px solid rgba(255,255,255,0.14);
  }
  .social-icon-btn:hover {
    transform: translateY(-2px) scale(1.06);
  }
  .social-wa { background: #25D366; color: #0b0e10; }
  .social-ig { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); }
  .social-fb { background: #1877F2; }

  /* Hero Section */
  .hero {
    background: radial-gradient(circle at top right, rgba(140, 224, 0, 0.18), transparent 55%),
                linear-gradient(180deg, #101518 0%, #0b0e10 100%);
    padding: 36px 20px 48px;
    border-bottom: 1px solid var(--card-border);
  }
  .hero-grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--lime-soft);
    border: 1px solid rgba(140, 224, 0, 0.45);
    color: var(--lime);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .hero h1 {
    font-size: clamp(1.95rem, 4vw, 2.9rem);
    font-weight: 900;
    line-height: 1.12;
    margin-bottom: 14px;
  }
  .hero h1 span {
    color: var(--lime);
  }
  .hero p {
    font-size: 1.02rem;
    color: #cbd5e1;
    margin-bottom: 22px;
    max-width: 540px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  .btn-cta-wa {
    background: var(--lime);
    color: #0b0e10;
    font-weight: 900;
    font-size: 0.98rem;
    padding: 14px 22px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    box-shadow: 0 6px 20px rgba(140, 224, 0, 0.28);
    transition: 0.18s;
  }
  .btn-cta-wa:hover {
    background: var(--lime-hover);
    transform: translateY(-2px);
  }
  .btn-cta-sec {
    background: #1a2126;
    color: #fff;
    border: 1px solid #334155;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 14px 18px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.18s;
  }
  .btn-cta-sec:hover {
    border-color: var(--lime);
    color: var(--lime);
  }

  .hero-social-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 8px;
    background: #14191d;
    border: 1px solid var(--card-border);
    color: #f1f5f9;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    transition: 0.15s;
  }
  .social-chip:hover {
    border-color: var(--lime);
    transform: translateY(-1px);
  }

  .hero-img-card {
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid var(--lime);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    background: #000;
  }
  .hero-img-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Sections */
  section {
    padding: 52px 20px;
    max-width: 1120px;
    margin: 0 auto;
  }
  .sec-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .sec-tag {
    color: var(--lime);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .sec-header h2 {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-weight: 900;
    margin-top: 4px;
  }
  .sec-header p {
    color: var(--text-muted);
    max-width: 600px;
    margin: 8px auto 0;
    font-size: 0.95rem;
  }

  /* Benefits Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .benefit-card {
    background: var(--card-dark);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
    transition: 0.18s;
  }
  .benefit-card:hover {
    border-color: var(--lime);
    transform: translateY(-3px);
  }
  .benefit-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: var(--lime-soft);
    border: 1.5px solid var(--lime);
    color: var(--lime);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .benefit-card h3 {
    font-size: 1rem;
    font-weight: 800;
    margin-bottom: 6px;
  }
  .benefit-card p {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  /* Antes e Depois Gallery */
  .ba-showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }
  .ba-poster {
    background: var(--card-dark);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
  }
  .ba-poster img {
    width: 100%;
    height: auto;
    display: block;
  }

  .car-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .car-pair-card {
    background: var(--card-dark);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 14px;
  }
  .car-pair-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--lime);
    margin-bottom: 10px;
    text-align: center;
    text-transform: uppercase;
  }
  .car-pair-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .img-box {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #334155;
  }
  .img-box img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
  }
  .tag-ba {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.5px;
  }
  .tag-antes {
    background: rgba(185, 28, 28, 0.92);
    color: #fff;
  }
  .tag-depois {
    background: var(--lime);
    color: #0b0e10;
  }

  /* Services & Prices */
  .services-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
    align-items: start;
  }
  .price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .price-card {
    background: var(--card-dark);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 14px;
  }
  .price-card h3 {
    color: var(--lime);
    font-size: 0.95rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 8px;
    border-bottom: 1px solid #252e34;
    padding-bottom: 5px;
  }
  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.84rem;
    padding: 5px 0;
    border-bottom: 1px dashed rgba(255,255,255,0.07);
    gap: 8px;
  }
  .price-row:last-child { border-bottom: none; }
  .price-val {
    font-weight: 900;
    color: #fff;
    background: rgba(140, 224, 0, 0.16);
    padding: 2px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .promo-flyer {
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid var(--lime);
    box-shadow: 0 10px 28px rgba(0,0,0,0.45);
  }
  .promo-flyer img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Quick Quote Calculator Box */
  .quote-box {
    background: linear-gradient(135deg, #14191d 0%, #1a2318 100%);
    border: 2px solid var(--lime);
    border-radius: 16px;
    padding: 26px 20px;
    margin-top: 28px;
  }
  .quote-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 10px;
    margin-top: 14px;
  }
  .quote-form-grid input, .quote-form-grid select {
    background: #0b0e10;
    border: 1px solid #334155;
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    width: 100%;
  }
  .quote-form-grid input:focus, .quote-form-grid select:focus {
    outline: none;
    border-color: var(--lime);
  }

  /* Social Hub Section */
  .social-hub {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .social-card {
    background: var(--card-dark);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 22px 18px;
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: 0.2s;
  }
  .social-card:hover {
    transform: translateY(-4px);
    border-color: var(--lime);
  }
  .social-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }
  .social-card h3 {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 4px;
  }
  .social-card span {
    font-size: 0.85rem;
    color: var(--lime);
    font-weight: 700;
  }
  .social-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 6px;
  }

  /* Footer */
  footer {
    background: #07090b;
    border-top: 1px solid var(--card-border);
    padding: 28px 20px 86px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  /* Floating WhatsApp Button */
  .floating-wa {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 999;
    background: #25D366;
    color: #0b0e10;
    font-weight: 900;
    font-size: 0.9rem;
    padding: 13px 18px;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.42);
    transition: transform 0.18s;
  }
  .floating-wa:hover { transform: scale(1.05); }

  /* Responsive */
  @media (max-width: 860px) {
    .hero-grid, .services-layout, .ba-showcase, .car-compare-grid {
      grid-template-columns: 1fr;
    }
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }
    .social-hub {
      grid-template-columns: 1fr;
    }
    .quote-form-grid {
      grid-template-columns: 1fr;
    }
    .nav-links a.menu-link {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .price-grid {
      grid-template-columns: 1fr;
    }
    .img-box img {
      height: 190px;
    }
  }
</style>
